;; The air-sched appview Worker. :esm, mirroring cloud-itonami/app-ongakuka and
;; cloud-itonami-marketplace-listing.
;;
;; wrangler.jsonc's `main` points at dist/worker.js, which is THIS bundle,
;; compiled from the source in src/. That is the whole point of the migration
;; recorded in docs/adr/0001: before it, `main` pointed at
;; svelte/.svelte-kit/cloudflare/_worker.js -- a build output that is not in the
;; tree -- and the TypeScript a reader opens (src/app.ts) was in no bundle at all.
;;
;; :warnings-as-errors is not decoration. shadow treats an undeclared or renamed
;; var as a WARNING, so `amu compile --target wasm32-browser worker` exits 0 while writing a
;; bundle that throws `Cannot read properties of undefined` on the first request.
;; "The build succeeded" is therefore not a check at all -- it cannot fail.
;; Demonstrated in THIS repo before landing the line (docs/operator-quickstart.md S4).
{:deps {:aliases [:cljs]}
 :builds
 {:worker
  {:target :esm
   :output-dir "dist"
   :modules {:worker {:exports {default air-sched.worker/handler}}}
   ;; NOTE the key lives under :compiler-options, NOT :build-options -- shadow
   ;; reads `[:compiler-options :warnings-as-errors]`
   ;; (shadow/build/compiler.clj `should-warning-throw?`). Under :build-options
   ;; it is silently ignored, which is the same failure this option exists to
   ;; prevent: a fix that cannot fail.
   :compiler-options {:output-feature-set :es2020
                      :infer-externs :auto
                      :warnings-as-errors true}}}}
